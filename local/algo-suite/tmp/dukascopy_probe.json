{
  "name" : "Download Dukascopy tick data (raw only)",
  "scenarios" : [ {
    "name" : "Planning performs no I/O",
    "steps" : [ {
      "keyword" : "When",
      "text" : "I plan dukascopy \"EURUSD\" for \"2020-01\""
    }, {
      "keyword" : "Then",
      "text" : "the plan lists 744 hour units"
    }, {
      "keyword" : "And",
      "text" : "no HTTP request was made"
    }, {
      "keyword" : "And",
      "text" : "no file was written under the data root"
    } ],
    "examples" : [ ]
  }, {
    "name" : "Happy path writes raw .bi5 at the canonical path",
    "steps" : [ {
      "keyword" : "When",
      "text" : "I download dukascopy \"EURUSD\" for \"2020-01\""
    }, {
      "keyword" : "Then",
      "text" : "a raw payload exists at \"raw/dukascopy/EURUSD/2020/01/02/14h.bi5\""
    }, {
      "keyword" : "And",
      "text" : "no file is written outside the raw store"
    }, {
      "keyword" : "And",
      "text" : "no unit is FAILED"
    }, {
      "keyword" : "And",
      "text" : "the run exits 0"
    } ],
    "examples" : [ ]
  }, {
    "name" : "Resume is a filesystem no-op",
    "steps" : [ {
      "keyword" : "Given",
      "text" : "\"EURUSD\" \"2020-01\" is already downloaded"
    }, {
      "keyword" : "When",
      "text" : "I download dukascopy \"EURUSD\" for \"2020-01\""
    }, {
      "keyword" : "Then",
      "text" : "no HTTP request was made"
    }, {
      "keyword" : "And",
      "text" : "every unit is SKIPPED"
    }, {
      "keyword" : "And",
      "text" : "the run exits 0"
    } ],
    "examples" : [ ]
  }, {
    "name" : "A no-data hour is MISSING and durable, not FAILED",
    "steps" : [ {
      "keyword" : "Given",
      "text" : "the datafeed has no data for \"EURUSD\" 2020-01-02 14h"
    }, {
      "keyword" : "When",
      "text" : "I download dukascopy \"EURUSD\" for \"2020-01\""
    }, {
      "keyword" : "Then",
      "text" : "\"raw/dukascopy/EURUSD/2020/01/02/14h.bi5\" exists as an empty payload"
    }, {
      "keyword" : "And",
      "text" : "that hour is counted MISSING"
    }, {
      "keyword" : "And",
      "text" : "the run exits 0"
    } ],
    "examples" : [ ]
  }, {
    "name" : "A failed hour writes nothing and flips the exit code",
    "steps" : [ {
      "keyword" : "Given",
      "text" : "the datafeed always errors for \"EURUSD\" 2020-01-02 14h"
    }, {
      "keyword" : "When",
      "text" : "I download dukascopy \"EURUSD\" for \"2020-01\""
    }, {
      "keyword" : "Then",
      "text" : "no file exists at \"raw/dukascopy/EURUSD/2020/01/02/14h.bi5\""
    }, {
      "keyword" : "And",
      "text" : "that hour is counted FAILED"
    }, {
      "keyword" : "And",
      "text" : "the run exits non-zero"
    } ],
    "examples" : [ ]
  }, {
    "name" : "USDJPY keeps its own identity",
    "steps" : [ {
      "keyword" : "When",
      "text" : "I download dukascopy \"USDJPY\" for \"2020-01\""
    }, {
      "keyword" : "Then",
      "text" : "a raw payload exists at \"raw/dukascopy/USDJPY/2020/01/02/14h.bi5\""
    }, {
      "keyword" : "And",
      "text" : "the run exits 0"
    } ],
    "examples" : [ ]
  } ],
  "background" : [ {
    "keyword" : "Given",
    "text" : "a writable data root"
  }, {
    "keyword" : "And",
    "text" : "the Dukascopy datafeed returns tick bytes by default"
  } ]
}
