{
  "name": "algo-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser results browser for algo-suite backtest runs (sql.js over results.sqlite).",
  "scripts": {
    "dev": "vite",
    "serve": "node --no-warnings=ExperimentalWarning --import=tsx server/main.ts",
    "start": "node --no-warnings=ExperimentalWarning dist-server/server/main.js",
    "build": "tsc -p tsconfig.json --noEmit && vite build && tsc -p tsconfig.server.json && node -e \"require('fs').writeFileSync('dist-server/package.json', JSON.stringify({type:'module'})+'\\n')\"",
    "preview": "vite preview",
    "lint": "eslint src server tests --max-warnings 0",
    "test": "NODE_OPTIONS='--import=tsx --no-warnings=ExperimentalWarning' cucumber-js"
  },
  "dependencies": {
    "lightweight-charts": "^5.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^11.3.0",
    "@eslint/js": "^9.30.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.0",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.0",
    "vite": "^6.3.5"
  }
}
